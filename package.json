{
  "name": "comment-sidecar",
  "displayName": "Comment Sidecar",
  "description": "Per-line comments in sibling .comment patches. Hover context, line tracking, review warnings, and agent CLI/MCP access without changing source.",
  "version": "1.2.0",
  "publisher": "zainzafar90",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zainzafar90/comment-sidecar"
  },
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18.17.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "comments",
    "context",
    "diff",
    "agents",
    "mcp"
  ],
  "main": "./src/extension/extension.js",
  "bin": {
    "sidecar": "./src/cli.js",
    "comment-sidecar-mcp": "./src/mcp.js"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Read-only hover works. Comment creation, editing and tracked sidecar writes require workspace trust."
    },
    "virtualWorkspaces": false
  },
  "scripts": {
    "test": "node scripts/test.js",
    "check": "node scripts/check-syntax.js && node scripts/check-style.js",
    "benchmark": "node scripts/benchmark.js",
    "package": "python3 scripts/package-vsix.py",
    "test:aliases": "node scripts/test-aliases.js",
    "clean": "node scripts/clean.js",
    "verify": "npm test && npm run test:aliases && npm run check",
    "release": "npm run verify && python3 scripts/package-release.py"
  },
  "contributes": {
    "languages": [
      {
        "id": "comment-sidecar",
        "aliases": [
          "Comment Sidecar"
        ],
        "extensions": [
          ".comment"
        ]
      }
    ],
    "grammars": [
      {
        "language": "comment-sidecar",
        "scopeName": "source.comment-sidecar",
        "path": "./media/comment-sidecar.tmLanguage.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "commentSidecar",
          "title": "Comment Sidecar",
          "icon": "media/icon.png"
        }
      ]
    },
    "views": {
      "commentSidecar": [
        {
          "id": "commentSidecar.review",
          "name": "Review"
        }
      ]
    },
    "commands": [
      {
        "command": "commentSidecar.add",
        "title": "Comment Sidecar: Add Comment at Line"
      },
      {
        "command": "commentSidecar.edit",
        "title": "Comment Sidecar: Edit Comment"
      },
      {
        "command": "commentSidecar.remove",
        "title": "Comment Sidecar: Delete Comment"
      },
      {
        "command": "commentSidecar.review",
        "title": "Comment Sidecar: Mark Comment Reviewed"
      },
      {
        "command": "commentSidecar.reanchor",
        "title": "Comment Sidecar: Reattach Comment to This Line"
      },
      {
        "command": "commentSidecar.openSidecar",
        "title": "Comment Sidecar: Open .comment Patch"
      },
      {
        "command": "commentSidecar.preview",
        "title": "Comment Sidecar: Open Annotated Preview"
      },
      {
        "command": "commentSidecar.copy",
        "title": "Comment Sidecar: Copy Annotated Selection"
      },
      {
        "command": "commentSidecar.list",
        "title": "Comment Sidecar: List File Comments"
      },
      {
        "command": "commentSidecar.check",
        "title": "Comment Sidecar: Check Workspace"
      },
      {
        "command": "commentSidecar.copyRules",
        "title": "Comment Sidecar: Copy Agent Instructions"
      },
      {
        "command": "commentSidecar.copyMcp",
        "title": "Comment Sidecar: Copy Cursor MCP Configuration"
      },
      {
        "command": "commentSidecar.review.open",
        "title": "Comment Sidecar: Jump to Comment",
        "icon": "$(go-to-file)"
      },
      {
        "command": "commentSidecar.review.hold",
        "title": "Comment Sidecar: Mark as Still Holds",
        "icon": "$(check)"
      },
      {
        "command": "commentSidecar.review.edit",
        "title": "Comment Sidecar: Update Comment",
        "icon": "$(edit)"
      },
      {
        "command": "commentSidecar.review.reattach",
        "title": "Comment Sidecar: Reattach Comment",
        "icon": "$(pin)"
      },
      {
        "command": "commentSidecar.review.refresh",
        "title": "Comment Sidecar: Refresh Review",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "commentSidecar.add",
          "when": "resourceScheme == file && isWorkspaceTrusted",
          "group": "commentSidecar@1"
        },
        {
          "command": "commentSidecar.edit",
          "when": "resourceScheme == file && isWorkspaceTrusted",
          "group": "commentSidecar@2"
        },
        {
          "command": "commentSidecar.preview",
          "when": "resourceScheme == file",
          "group": "commentSidecar@3"
        }
      ],
      "view/title": [
        {
          "command": "commentSidecar.review.refresh",
          "when": "view == commentSidecar.review",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "commentSidecar.review.open",
          "when": "view == commentSidecar.review && viewItem =~ /Item$/",
          "group": "navigation@1"
        },
        {
          "command": "commentSidecar.review.hold",
          "when": "view == commentSidecar.review && viewItem == commentSidecar.reviewItem && isWorkspaceTrusted",
          "group": "inline@1"
        },
        {
          "command": "commentSidecar.review.edit",
          "when": "view == commentSidecar.review && viewItem == commentSidecar.reviewItem && isWorkspaceTrusted",
          "group": "inline@2"
        },
        {
          "command": "commentSidecar.review.reattach",
          "when": "view == commentSidecar.review && viewItem == commentSidecar.reviewItem && isWorkspaceTrusted",
          "group": "inline@3"
        },
        {
          "command": "commentSidecar.review.reattach",
          "when": "view == commentSidecar.review && viewItem == commentSidecar.detachedItem && isWorkspaceTrusted",
          "group": "inline@1"
        },
        {
          "command": "commentSidecar.review.reattach",
          "when": "view == commentSidecar.review && viewItem == commentSidecar.ambiguousItem && isWorkspaceTrusted",
          "group": "inline@1"
        }
      ],
      "commandPalette": [
        {
          "command": "commentSidecar.review.open",
          "when": "false"
        },
        {
          "command": "commentSidecar.review.hold",
          "when": "false"
        },
        {
          "command": "commentSidecar.review.edit",
          "when": "false"
        },
        {
          "command": "commentSidecar.review.reattach",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "commentSidecar.add",
        "key": "ctrl+alt+;",
        "mac": "cmd+alt+;",
        "when": "editorTextFocus && resourceScheme == file && isWorkspaceTrusted"
      }
    ],
    "configurationDefaults": {
      "explorer.fileNesting.enabled": true,
      "explorer.fileNesting.expand": false,
      "explorer.fileNesting.patterns": {
        "*": "${capture}.comment"
      }
    },
    "configuration": {
      "title": "Comment Sidecar",
      "properties": {
        "commentSidecar.showMarkers": {
          "type": "boolean",
          "default": true,
          "description": "Show the external-comment marker. Enabled by default. Use markerStyle to choose the labeled ring or ring only."
        },
        "commentSidecar.showHoverMetadata": {
          "type": "boolean",
          "default": false,
          "description": "Include annotation IDs, attachment status and revision details in hovers. Off by default; review warnings remain visible."
        },
        "commentSidecar.highlightStyle": {
          "type": "string",
          "enum": [
            "line",
            "underline",
            "off"
          ],
          "default": "line",
          "enumDescriptions": [
            "Subtle whole-line tint and left edge; amber when review is needed.",
            "Underline annotated code without a line background.",
            "Do not highlight annotated lines; hover remains available."
          ],
          "description": "How annotated source lines are highlighted. Does not replace syntax colors or change source text."
        },
        "commentSidecar.markerStyle": {
          "type": "string",
          "enum": [
            "label",
            "icon",
            "off"
          ],
          "default": "label",
          "enumDescriptions": [
            "Dashed circle and comment text: ◌ comment.",
            "Dashed circle only: ◌.",
            "Hide markers; comments are still available on hover."
          ],
          "description": "Annotation marker appearance. Existing showMarkers: false settings still hide markers. Review markers append !."
        }
      }
    },
    "colors": [
      {
        "id": "commentSidecar.sidecarForeground",
        "description": "Explorer and tab label color for .comment sidecar files.",
        "defaults": {
          "dark": "disabledForeground",
          "light": "disabledForeground",
          "highContrast": "disabledForeground",
          "highContrastLight": "disabledForeground"
        }
      },
      {
        "id": "commentSidecar.highlightBackground",
        "description": "Background for lines with external comments. Use transparency.",
        "defaults": {
          "dark": "#4CA6FF12",
          "light": "#1473E60D",
          "highContrast": "#00000000",
          "highContrastLight": "#00000000"
        }
      },
      {
        "id": "commentSidecar.highlightBorder",
        "description": "Left edge or underline for lines with external comments.",
        "defaults": {
          "dark": "#71B7FF88",
          "light": "#1668BD88",
          "highContrast": "contrastBorder",
          "highContrastLight": "contrastBorder"
        }
      },
      {
        "id": "commentSidecar.reviewBackground",
        "description": "Background for comments needing review. Use transparency.",
        "defaults": {
          "dark": "#E6AF2E16",
          "light": "#BA7B1010",
          "highContrast": "#00000000",
          "highContrastLight": "#00000000"
        }
      },
      {
        "id": "commentSidecar.reviewBorder",
        "description": "Left edge or underline for comments needing review.",
        "defaults": {
          "dark": "#E6AF2EA0",
          "light": "#9C610CB0",
          "highContrast": "editorWarning.foreground",
          "highContrastLight": "editorWarning.foreground"
        }
      }
    ]
  }
}
